  font-weight:650;
  text-overflow:ellipsis;
}

/* ---------- Stats ---------- */
.lmwa-stats{
  display:grid;
  grid-template-columns:repeat(3,minmax(0,1fr));
  gap:12px;
  margin:18px 0 0;
}

.lmwa-stat{
