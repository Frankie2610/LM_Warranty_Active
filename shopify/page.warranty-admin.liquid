    {% if warranty_admin_key != blank %}

<script>

const shopifyAdminNode = document.getElementById('lmwa-shopify-admin-data');
const SHOPIFY_ADMIN = JSON.parse(shopifyAdminNode?.textContent || '{}');
const ADMIN_ACCESS_KEY = String(SHOPIFY_ADMIN.adminAccessKey || '');

if (!ADMIN_ACCESS_KEY) {
  throw new Error('Không đọc được Warranty Admin Access Key từ tag Shopify của tài khoản này.');
}

if (ADMIN_ACCESS_KEY.length < 32) {
  throw new Error('Warranty Admin Access Key phải dài tối thiểu 32 ký tự.');
}

/* =========================================================
   CHANGE THIS ONE VALUE AFTER VERCEL DEPLOYMENT
========================================================= */
const API_BASE = 'https://REPLACE-WITH-YOUR-VERCEL-DOMAIN.vercel.app/api/warranty';

const PAGE_SIZE = 50;

const BRAND_RULES = [
  ['GUESS', /^GW0/],
  ['TED BAKER', /^BKP/],
  ['PHILIPP PLEIN', /^PW/],
  ['ADIDAS', /^AO/],
  ['FURLA', /^WW/],
  ['LOCMAN ITALY', /^(?:D\d{3}[A-Z]|0\d{3}[A-Z])/],
  ['VERSUS BY VERSACE', /^VSP/],
  ['MISSONI', /^MWY/]
];

const state = {
  warranties: [],
  page: 1,
  deleteTarget: null,
  authorized: false
};

const $ = (id) => document.getElementById(id);
const els = {
  admin: $('lmwa-admin'),
  currentEmail: $('lmwa-current-email'),

  total: $('stat-total'),
  pending: $('stat-pending'),
  activated: $('stat-activated'),

  createForm: $('create-form'),
  createMessage: $('create-message'),
  createResult: $('create-result'),
  saveCreate: $('save-create'),
  resetCreate: $('reset-create'),
  generateCode: $('generate-code'),
  cName: $('c-name'),
  cPhone: $('c-phone'),
  cEmail: $('c-email'),
  cSku: $('c-sku'),
  cBrand: $('c-brand'),
  cBrandField: $('c-brand-field'),
  cBrandNote: $('c-brand-note'),
  cProductName: $('c-product-name'),
  cDate: $('c-date'),
  cLocation: $('c-location'),
  cCode: $('c-code'),

  list: $('warranty-list'),
  listMeta: $('list-meta'),
  search: $('search-list'),
  filter: $('filter-status'),
  refresh: $('refresh-list'),
  migrate: $('migrate-old'),
  migrationMessage: $('migration-message'),
  pagination: $('pagination'),
  paginationSummary: $('pagination-summary'),
  pageNumbers: $('page-numbers'),
  pagePrev: $('page-prev'),
  pageNext: $('page-next'),

  editModal: $('edit-modal'),
  editForm: $('edit-form'),
  editMessage: $('edit-message'),
  eOriginalCode: $('e-original-code'),
  eCode: $('e-code'),
  eSku: $('e-sku'),
  eBrand: $('e-brand'),
  eBrandField: $('e-brand-field'),
  eBrandNote: $('e-brand-note'),
  eProductName: $('e-product-name'),
  eName: $('e-name'),
  ePhone: $('e-phone'),
  eEmail: $('e-email'),
  eDate: $('e-date'),
  eLocation: $('e-location'),
  eStatus: $('e-status'),
  saveEdit: $('save-edit'),

  deleteModal: $('delete-modal'),
  deleteCode: $('delete-code'),
  deleteMessage: $('delete-message'),
  confirmDelete: $('confirm-delete')
};

const normalizeSku = (v) => String(v || '').trim().toUpperCase();
const normalizeCode = (v) => String(v || '').trim().toUpperCase().replace(/\s+/g, '');
const normalizeEmail = (v) => String(v || '').trim().toLowerCase();
const normalizePhone = (v) => String(v || '').replace(/[^\d+]/g, '').trim();

function esc(v) {
  const d = document.createElement('div');
  d.textContent = v == null ? '' : String(v);
  return d.innerHTML;
}

function detectBrand(v) {
  const sku = normalizeSku(v);
  const match = BRAND_RULES.find(([, re]) => re.test(sku));
  return match ? match[0] : '';
}

function formatDate(v) {
  if (!v) return '—';
  const d = new Date(v + 'T00:00:00');
  return Number.isNaN(d.getTime())
    ? v
    : d.toLocaleDateString('vi-VN', { day: '2-digit', month: '2-digit', year: 'numeric' });
}

function formatDateTime(v) {
  if (!v) return '';
  const d = new Date(v);
  return Number.isNaN(d.getTime())
    ? ''
    : d.toLocaleString('vi-VN', {
        day: '2-digit',
        month: '2-digit',
        year: 'numeric',
        hour: '2-digit',
        minute: '2-digit'
      });
}

function setToday() {
  if (els.cDate.value) return;
  const d = new Date();
  const local = new Date(d.getTime() - d.getTimezoneOffset() * 60000);
  els.cDate.value = local.toISOString().slice(0, 10);
}

function showMessage(el, type, text) {
  el.hidden = false;
  el.className = 'lmwa-message ' + type;
  el.textContent = text;
}

function hideMessage(el) {
  el.hidden = true;
  el.textContent = '';
  el.className = 'lmwa-message';
}

async function api(path, options = {}) {
  const headers = {
    Accept: 'application/json',
    ...(options.body ? { 'Content-Type': 'application/json' } : {}),
    ...(options.headers || {}),
    'X-Warranty-Admin-Key': ADMIN_ACCESS_KEY,
    'X-Shopify-Customer-Email': SHOPIFY_ADMIN.email || ''
  };

  const response = await fetch(API_BASE + path, {
    cache: 'no-store',
    ...options,
    headers
  });

  const payload = await response.json().catch(() => ({}));

  if (!response.ok) {
    const error = new Error(payload.error || 'Yêu cầu không thành công.');
    error.status = response.status;
    throw error;
  }

  return payload;
}

function syncBrand(input, brandInput, field, note) {
  const upper = normalizeSku(input.value);
  if (input.value !== upper) input.value = upper;

  const brand = detectBrand(upper);
  brandInput.value = upper ? (brand || 'CHƯA NHẬN DIỆN') : '';

  field.classList.toggle('recognized', Boolean(brand));
  field.classList.toggle('unrecognized', Boolean(upper) && !brand);

  note.textContent = !upper
    ? 'Tự nhận diện theo cấu trúc SKU.'
    : brand
      ? `Đã nhận diện ${brand} · Bảo hành 24 tháng.`
      : 'SKU chưa khớp 8 thương hiệu đang cấu hình.';

  return brand;
}

const syncCreateBrand = () =>
  syncBrand(els.cSku, els.cBrand, els.cBrandField, els.cBrandNote);

const syncEditBrand = () =>
  syncBrand(els.eSku, els.eBrand, els.eBrandField, els.eBrandNote);

els.cSku.addEventListener('input', syncCreateBrand);
els.eSku.addEventListener('input', syncEditBrand);

els.cSku.addEventListener('blur', async () => {
  const sku = normalizeSku(els.cSku.value);
  syncCreateBrand();

  if (!sku || els.cProductName.value.trim()) return;

  try {
    const data = await api('/admin/product?sku=' + encodeURIComponent(sku));
    if (data.productName) els.cProductName.value = data.productName;
  } catch (error) {
    console.warn('Product lookup:', error);
  }
});

document.querySelectorAll('.lmwa-tab').forEach((tab) => {
  tab.addEventListener('click', () => {
    document.querySelectorAll('.lmwa-tab').forEach((x) => x.classList.toggle('active', x === tab));
    document.querySelectorAll('.lmwa-panel').forEach((panel) => {
      panel.classList.toggle('active', panel.dataset.panel === tab.dataset.tab);
    });
  });
});

function createPayload() {
  return {
    customerName: els.cName.value.trim(),
    phone: normalizePhone(els.cPhone.value),
    email: normalizeEmail(els.cEmail.value),
    sku: normalizeSku(els.cSku.value),
    productName: els.cProductName.value.trim(),
    purchaseDate: els.cDate.value,
    purchaseLocation: els.cLocation.value,
    warrantyNumber: normalizeCode(els.cCode.value)
  };
}

els.generateCode.addEventListener('click', async () => {
  const original = els.generateCode.textContent;
  els.generateCode.disabled = true;
  els.generateCode.textContent = 'ĐANG TẠO';

  try {
    const data = await api('/admin/generate-code');
    els.cCode.value = data.warrantyNumber || '';
  } catch (error) {
    showMessage(els.createMessage, 'error', error.message);
  } finally {
    els.generateCode.disabled = false;
    els.generateCode.textContent = original;
  }
});

els.createForm.addEventListener('submit', async (event) => {
  event.preventDefault();
  hideMessage(els.createMessage);
  els.createResult.hidden = true;

  if (!syncCreateBrand()) {
    return showMessage(els.createMessage, 'error', 'SKU chưa nhận diện được thương hiệu.');
  }

  const original = els.saveCreate.textContent;
  els.saveCreate.disabled = true;
  els.saveCreate.textContent = 'ĐANG LƯU';

  try {
    const result = await api('/admin/create', {
      method: 'POST',
      body: JSON.stringify(createPayload())
    });

    const w = result.warranty;

    els.createResult.hidden = false;
    els.createResult.innerHTML = `
      <div class="lmwa-kicker">PHIẾU ĐÃ ĐƯỢC TẠO</div>
      <h3>${esc(w.warranty_number)}</h3>
      <p>Phiếu đang ở trạng thái chờ khách hàng kích hoạt.</p>
      <div class="lmwa-created-grid">
        <div><span>Khách hàng</span><strong>${esc(w.customer_name)}</strong></div>
        <div><span>SKU</span><strong>${esc(w.sku)}</strong><small>${esc(w.brand)}</small></div>
        <div><span>Ngày mua</span><strong>${esc(formatDate(w.purchase_date))}</strong></div>
        <div><span>Thời hạn</span><strong>24 tháng</strong></div>
      </div>
    `;

    els.createForm.reset();
    els.cBrand.value = '';
    setToday();
    syncCreateBrand();

    await loadWarranties();
  } catch (error) {
    showMessage(els.createMessage, 'error', error.message);
  } finally {
    els.saveCreate.disabled = false;
    els.saveCreate.textContent = original;
  }
});

els.resetCreate.addEventListener('click', () => {
  els.createForm.reset();
  els.cBrand.value = '';
  els.createResult.hidden = true;
  hideMessage(els.createMessage);
  setToday();
  syncCreateBrand();
});

async function loadWarranties() {
  els.listMeta.textContent = 'Đang tải dữ liệu...';

  try {
    const data = await api('/admin/list');
    state.warranties = Array.isArray(data.warranties) ? data.warranties : [];
    state.page = 1;
    updateStats();
    renderList();
  } catch (error) {
    els.listMeta.textContent = 'Không thể tải dữ liệu.';
    els.list.innerHTML = `<div class="lmwa-empty"><strong>Không thể tải danh sách</strong><span>${esc(error.message)}</span></div>`;
  }
}

function updateStats() {
  const total = state.warranties.length;
  const activated = state.warranties.filter((x) => x.status === 'activated').length;
  els.total.textContent = total.toLocaleString('vi-VN');
  els.activated.textContent = activated.toLocaleString('vi-VN');
  els.pending.textContent = (total - activated).toLocaleString('vi-VN');
}

function filtered() {
  const q = String(els.search.value || '').trim().toLowerCase();
  const f = els.filter.value;

  return state.warranties.filter((item) => {
    const statusOk =
      f === 'all' ||
      (f === 'activated' && item.status === 'activated') ||
      (f === 'pending' && item.status !== 'activated');

    if (!statusOk) return false;
    if (!q) return true;

    return [
      item.warranty_number,
      item.customer_name,
      item.customer_phone,
      item.customer_email,
      item.sku,
      item.brand,
      item.product_name
    ].join(' ').toLowerCase().includes(q);
  });
}

function pageItems(current, total) {
  if (total <= 7) return Array.from({ length: total }, (_, i) => i + 1);

  const arr = [1];
  if (current > 4) arr.push('left');

  const start = Math.max(2, current - 1);
  const end = Math.min(total - 1, current + 1);

  for (let p = start; p <= end; p++) arr.push(p);

  if (current < total - 3) arr.push('right');
  arr.push(total);

  return arr;
}

function renderPagination(total, start, end) {
  const pages = Math.max(1, Math.ceil(total / PAGE_SIZE));

  if (total <= PAGE_SIZE) {
    els.pagination.hidden = true;
    return;
  }

  els.pagination.hidden = false;
  els.paginationSummary.textContent =
    `Hiển thị ${start + 1}–${end} trên ${total.toLocaleString('vi-VN')} phiếu`;

  els.pagePrev.disabled = state.page <= 1;
  els.pageNext.disabled = state.page >= pages;

  els.pageNumbers.innerHTML = pageItems(state.page, pages).map((p) => {
    if (typeof p === 'string') return '<span class="lmwa-ellipsis">…</span>';

    return `<button type="button" class="${p === state.page ? 'active' : ''}" data-page="${p}">${p}</button>`;
  }).join('');
}

function renderList() {
  const rows = filtered();
  const total = rows.length;
  const pages = Math.max(1, Math.ceil(total / PAGE_SIZE));

  if (state.page > pages) state.page = pages;

  if (!total) {
    els.listMeta.textContent = '0 phiếu được hiển thị';
    els.list.innerHTML =
      '<div class="lmwa-empty"><strong>Không tìm thấy dữ liệu phù hợp</strong><span>Thử thay đổi từ khóa hoặc bộ lọc.</span></div>';
    els.pagination.hidden = true;
    return;
  }

  const start = (state.page - 1) * PAGE_SIZE;
  const end = Math.min(start + PAGE_SIZE, total);
  const pageRows = rows.slice(start, end);

  els.listMeta.textContent = total > PAGE_SIZE
    ? `Đang hiển thị ${start + 1}–${end} trong ${total.toLocaleString('vi-VN')} phiếu`
    : `${total.toLocaleString('vi-VN')} phiếu được hiển thị`;

  els.list.innerHTML = pageRows.map((item) => {
    const activated = item.status === 'activated';

    return `
      <article class="lmwa-row">
        <div class="lmwa-row-main">
          <span class="lmwa-row-label">Số bảo hành</span>
          <strong>${esc(item.warranty_number || '—')}</strong>
          <small>${esc(item.product_name || item.sku || 'Chưa có tên sản phẩm')}</small>
        </div>

        <div>
          <span class="lmwa-row-label">Khách hàng</span>
          <strong>${esc(item.customer_name || '—')}</strong>
          <small>${esc(item.customer_phone || item.customer_email || '—')}</small>
        </div>

        <div>
          <span class="lmwa-row-label">SKU / Thương hiệu</span>
          <strong>${esc(item.sku || '—')}</strong>
          <small>${esc(item.brand || detectBrand(item.sku) || '—')} · ${esc(formatDate(item.purchase_date))}</small>
        </div>

        <div class="lmwa-row-status">
          <span class="lmwa-row-label">Trạng thái</span>
          <span class="lmwa-status ${activated ? 'activated' : 'pending'}">
            ${activated ? 'Đã kích hoạt' : 'Chưa kích hoạt'}
          </span>
          <small>${esc(formatDateTime(item.created_at))}</small>
        </div>

        <div class="lmwa-row-actions">
          <button type="button" class="edit" data-edit="${esc(item.warranty_number)}">CHỈNH SỬA</button>
          <button type="button" class="delete" data-delete="${esc(item.warranty_number)}">XÓA</button>
        </div>
      </article>
    `;
  }).join('');

  renderPagination(total, start, end);
}

function goPage(page) {
  const pages = Math.max(1, Math.ceil(filtered().length / PAGE_SIZE));
  state.page = Math.max(1, Math.min(Number(page) || 1, pages));
  renderList();

  const y = els.listMeta.getBoundingClientRect().top + window.scrollY - 100;
  window.scrollTo({ top: Math.max(0, y), behavior: 'smooth' });
}

let searchTimer = null;
els.search.addEventListener('input', () => {
  clearTimeout(searchTimer);
  searchTimer = setTimeout(() => {
    state.page = 1;
    renderList();
  }, 120);
});

els.filter.addEventListener('change', () => {
  state.page = 1;
  renderList();
});

els.refresh.addEventListener('click', loadWarranties);
els.pagePrev.addEventListener('click', () => goPage(state.page - 1));
els.pageNext.addEventListener('click', () => goPage(state.page + 1));
els.pageNumbers.addEventListener('click', (event) => {
  const button = event.target.closest('[data-page]');
  if (button) goPage(Number(button.dataset.page));
});

els.migrate.addEventListener('click', async () => {
  if (!window.confirm('Đồng bộ dữ liệu bảo hành cũ sang index warranties? Dữ liệu index hiện có sẽ không bị ghi đè.')) return;

  const original = els.migrate.textContent;
  els.migrate.disabled = true;
  els.migrate.textContent = 'ĐANG ĐỒNG BỘ';
  hideMessage(els.migrationMessage);

  try {
    const data = await api('/admin/migrate', {
      method: 'POST',
      body: JSON.stringify({})
    });

    showMessage(
      els.migrationMessage,
      'success',
      `Đồng bộ hoàn tất: tạo ${data.created || 0} index mới, bỏ qua ${data.skipped || 0} index đã tồn tại.`
    );

    await loadWarranties();
  } catch (error) {
    showMessage(els.migrationMessage, 'error', error.message);
  } finally {
    els.migrate.disabled = false;
    els.migrate.textContent = original;
  }
});

function findRecord(code) {
  return state.warranties.find((x) => x.warranty_number === code) || null;
}

function openModal(modal) {
  modal.hidden = false;
  document.documentElement.classList.add('lmwa-modal-open');
}

function closeModal(modal) {
  modal.hidden = true;
  document.documentElement.classList.remove('lmwa-modal-open');
}

document.querySelectorAll('[data-close-edit]').forEach((x) =>
  x.addEventListener('click', () => closeModal(els.editModal))
);

document.querySelectorAll('[data-close-delete]').forEach((x) =>
  x.addEventListener('click', () => closeModal(els.deleteModal))
);

function openEdit(record) {
  hideMessage(els.editMessage);

  els.eOriginalCode.value = record.warranty_number || '';
  els.eCode.value = record.warranty_number || '';
  els.eSku.value = record.sku || '';
  els.eProductName.value = record.product_name || '';
  els.eName.value = record.customer_name || '';
  els.ePhone.value = record.customer_phone || '';
  els.eEmail.value = record.customer_email || '';
  els.eDate.value = record.purchase_date || '';
  els.eLocation.value = record.purchase_location || 'Khác';

  els.eStatus.textContent = record.status === 'activated'
    ? 'Đã kích hoạt'
    : 'Chưa kích hoạt';

  els.eStatus.className =
    'lmwa-status ' + (record.status === 'activated' ? 'activated' : 'pending');

  syncEditBrand();
  openModal(els.editModal);
}

function openDelete(record) {
  state.deleteTarget = record;
  els.deleteCode.textContent = record.warranty_number || '';
  els.deleteMessage.hidden = true;
  openModal(els.deleteModal);
}

els.list.addEventListener('click', (event) => {
  const edit = event.target.closest('[data-edit]');

  if (edit) {
    const record = findRecord(edit.dataset.edit);
    if (record) openEdit(record);
    return;
  }

  const del = event.target.closest('[data-delete]');

  if (del) {
    const record = findRecord(del.dataset.delete);
    if (record) openDelete(record);
  }
});

els.editForm.addEventListener('submit', async (event) => {
  event.preventDefault();
  hideMessage(els.editMessage);

  if (!syncEditBrand()) {
    return showMessage(els.editMessage, 'error', 'SKU chưa nhận diện được thương hiệu.');
  }

  const original = els.saveEdit.textContent;
  els.saveEdit.disabled = true;
  els.saveEdit.textContent = 'ĐANG LƯU';

  try {
    await api('/admin/update', {
      method: 'POST',
      body: JSON.stringify({
        originalCode: normalizeCode(els.eOriginalCode.value),
        warrantyNumber: normalizeCode(els.eCode.value),
        sku: normalizeSku(els.eSku.value),
        productName: els.eProductName.value.trim(),
        customerName: els.eName.value.trim(),
        phone: normalizePhone(els.ePhone.value),
        email: normalizeEmail(els.eEmail.value),
        purchaseDate: els.eDate.value,
        purchaseLocation: els.eLocation.value
      })
    });

    closeModal(els.editModal);
    await loadWarranties();
  } catch (error) {
    showMessage(els.editMessage, 'error', error.message);
  } finally {
    els.saveEdit.disabled = false;
    els.saveEdit.textContent = original;
  }
});

els.confirmDelete.addEventListener('click', async () => {
  if (!state.deleteTarget) return;

  const original = els.confirmDelete.textContent;
  els.confirmDelete.disabled = true;
  els.confirmDelete.textContent = 'ĐANG XÓA';
  hideMessage(els.deleteMessage);

  try {
    await api('/admin/delete', {
      method: 'POST',
      body: JSON.stringify({
        warrantyNumber: state.deleteTarget.warranty_number
      })
    });

    state.deleteTarget = null;
    closeModal(els.deleteModal);
    await loadWarranties();
  } catch (error) {
    showMessage(els.deleteMessage, 'error', error.message);
  } finally {
    els.confirmDelete.disabled = false;
    els.confirmDelete.textContent = original;
  }
});

els.currentEmail.textContent = SHOPIFY_ADMIN.email || '—';
setToday();
syncCreateBrand();
loadWarranties();

</script>

