        account.dataset.bound='1';

        account.addEventListener('close',function(){
          setTimeout(function(){
            window.location.reload();
          },850);
        });
      }

      if(customElements.get('shopify-account')){
        bindAccount();
      }else{
        customElements.whenDefined('shopify-account').then(bindAccount).catch(function(){});
