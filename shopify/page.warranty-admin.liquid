  box-shadow:0 4px 12px rgba(31,42,34,.08);
}

/* ---------- Panels ---------- */
.lmwa-panel{display:none;padding-top:30px}
.lmwa-panel.active{display:block}

.lmwa-section-header,
.lmwa-list-header{
  display:flex;
  justify-content:space-between;
  gap:24px;
  align-items:flex-end;
  margin-bottom:18px;
}

.lmwa-kicker{
  color:var(--forest-2);
  font-size:8px;
  font-weight:840;
  letter-spacing:.13em;
  text-transform:uppercase;
}

.lmwa-section-header h2,
.lmwa-list-header h2,
.lmwa-dialog-header h2{
  margin:7px 0 0;
  color:var(--ink);
  font-size:25px;
  font-weight:730;
  line-height:1.15;
  letter-spacing:-.025em;
}

.lmwa-section-header>p,
.lmwa-dialog-header p{
  max-width:420px;
  margin:0;
  color:var(--muted);
  font-size:11px;
  font-weight:500;
  line-height:1.6;
}

/* ---------- Create form ---------- */
#create-form{
  overflow:hidden;
  border:1px solid var(--line);
  border-radius:17px;
  background:#fff;
  box-shadow:0 12px 32px rgba(31,42,34,.045);
}

.lmwa-form-card{
  padding:28px 30px 30px;
  background:#fff;
}

.lmwa-form-card + .lmwa-form-card{
  border-top:1px solid #e4e8e5;
}

.lmwa-form-title{
  display:flex;
  gap:13px;
  align-items:flex-start;
  margin-bottom:23px;
}

.lmwa-form-title>span{
  display:flex;
  width:31px;
  height:31px;
  flex:0 0 31px;
  align-items:center;
  justify-content:center;
  border-radius:8px;
  background:var(--forest);
  color:#fff;
  font-size:9px;
  font-weight:820;
}

.lmwa-form-title strong,
.lmwa-form-title small{display:block}
.lmwa-form-title strong{
  color:var(--ink);
  font-size:15px;
  font-weight:720;
}
.lmwa-form-title small{
  max-width:640px;
  margin-top:4px;
  color:#7a837c;
  font-size:10px;
  font-weight:500;
  line-height:1.55;
}

/* ---------- Fields: intentionally flat, not cards ---------- */
.lmwa-grid{
  display:grid;
  gap:17px 18px;
}
.lmwa-grid.two{grid-template-columns:repeat(2,minmax(0,1fr))}
.lmwa-field.full{grid-column:1/-1}

.lmwa-field{
  display:flex;
  min-width:0;
  flex-direction:column;
  margin:0;
}

.lmwa-field>span:first-child,
.lmwa-field-label{
  display:block;
  margin:0 0 7px;
  color:#414c44;
  font-size:10px;
  font-weight:720;
  line-height:1.3;
}

.lmwa-field>small{
  display:block;
  margin:6px 2px 0;
  color:#8b928d;
  font-size:9px;
  font-weight:500;
  line-height:1.45;
}

.lmwa-field input,
.lmwa-field select{
  width:100%;
