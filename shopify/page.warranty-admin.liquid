{% endcomment %}

<script>
(function(){
  var src='https://cdn.shopify.com/storefront/web-components.js';

  if(
    !customElements.get('shopify-account') &&
    !document.querySelector('script[src="'+src+'"]')
  ){
    var s=document.createElement('script');
    s.src=src;
    s.async=true;
    document.head.appendChild(s);
  }
})();
</script>

