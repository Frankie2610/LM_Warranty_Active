  --pending-bg:#f5f0e5;
  --success:#28563a;
  --success-bg:#e8f1ea;

  box-sizing:border-box;
  width:100%;
  padding:34px 18px 72px;
  background:
    radial-gradient(circle at 8% 0%,rgba(36,68,48,.07),transparent 26%),
