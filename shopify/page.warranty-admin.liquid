{% comment %}
  L&M WARRANTY ADMIN — V9.0 REACT UI
  Shopify Customer Account / OTP + customer tag authorization.
  React renders the entire authenticated Admin interface.
{% endcomment %}

<script>
(function(){
  var src='https://cdn.shopify.com/storefront/web-components.js';
  if(
    !customElements.get('shopify-account') &&
    !document.querySelector('script[src="'+src+'"]')
  ){
    var s=document.createElement('script');
    s.src=src;
    s.async=true;
    document.head.appendChild(s);
  }
})();
</script>

{% assign warranty_admin_tag = 'warranty-admin' %}
{% assign warranty_admin_key = '' %}

{% if customer %}
  {% for tag in customer.tags %}
    {% if tag contains 'warranty-admin-key-' %}
      {% assign warranty_admin_key = tag | remove_first: 'warranty-admin-key-' | strip %}
    {% endif %}
  {% endfor %}
{% endif %}

<section class="lmreact-shell">
  {% if customer %}
    {% if customer.tags contains warranty_admin_tag %}
      {% if warranty_admin_key != blank %}

        <script id="lmreact-admin-data" type="application/json">
          {
            "id": {{ customer.id | json }},
            "email": {{ customer.email | json }},
            "firstName": {{ customer.first_name | json }},
            "lastName": {{ customer.last_name | json }},
            "adminAccessKey": {{ warranty_admin_key | json }}
          }
        </script>

        <div id="lmreact-root">
          <div class="lmreact-boot">Đang khởi tạo khu vực quản lý bảo hành...</div>
        </div>

        <script crossorigin src="https://cdn.jsdelivr.net/npm/react@18.3.1/umd/react.production.min.js"></script>
        <script crossorigin src="https://cdn.jsdelivr.net/npm/react-dom@18.3.1/umd/react-dom.production.min.js"></script>
        <script src="https://cdn.jsdelivr.net/npm/htm@3.1.1/dist/htm.umd.js"></script>

        <script>
        (function(){
          const { useEffect, useMemo, useRef, useState } = React;
          const html = htm.bind(React.createElement);

          const adminNode = document.getElementById('lmreact-admin-data');
          const ADMIN = JSON.parse(adminNode?.textContent || '{}');
          const ADMIN_ACCESS_KEY = String(ADMIN.adminAccessKey || '');
          const API_BASE = 'https://lm-warranty-active.vercel.app/api/warranty';
          const PAGE_SIZE = 50;

          if (!ADMIN_ACCESS_KEY || ADMIN_ACCESS_KEY.length < 32) {
            document.getElementById('lmreact-root').innerHTML =
              '<div class="lmreact-auth-error"><strong>Không thể mở khu vực quản trị</strong><span>Thông tin quyền truy cập chưa hợp lệ.</span></div>';
            return;
          }

          const BRAND_RULES = [
            ['GUESS', /^GW0/],
            ['TED BAKER', /^BKP/],
            ['PHILIPP PLEIN', /^PW/],
            ['ADIDAS', /^AO/],
            ['FURLA', /^WW/],
            ['LOCMAN ITALY', /^(?:D\d{3}[A-Z]|0\d{3}[A-Z])/],
            ['VERSUS BY VERSACE', /^VSP/],
            ['MISSONI', /^MWY/]
          ];

          const LOCATION_OPTIONS = ['Showroom L&M', 'Online', 'Đại lý', 'Khác'];

          const normalizeSku = (v) => String(v || '').trim().toUpperCase();
          const normalizeCode = (v) => String(v || '').trim().toUpperCase().replace(/\s+/g, '');
          const normalizeEmail = (v) => String(v || '').trim().toLowerCase();
          const normalizePhone = (v) => String(v || '').replace(/[^\d+]/g, '').trim();

          function detectBrand(v) {
            const sku = normalizeSku(v);
            const match = BRAND_RULES.find(([, re]) => re.test(sku));
            return match ? match[0] : '';
          }

          function today() {
            const d = new Date();
            const local = new Date(d.getTime() - d.getTimezoneOffset() * 60000);
            return local.toISOString().slice(0, 10);
          }

          function formatDate(v) {
            if (!v) return '—';
            const d = new Date(v + 'T00:00:00');
            return Number.isNaN(d.getTime())
              ? v
              : d.toLocaleDateString('vi-VN', {day:'2-digit', month:'2-digit', year:'numeric'});
          }

          function formatDateTime(v) {
            if (!v) return '';
            const d = new Date(v);
            return Number.isNaN(d.getTime())
              ? ''
              : d.toLocaleString('vi-VN', {
                  day:'2-digit', month:'2-digit', year:'numeric',
                  hour:'2-digit', minute:'2-digit'
                });
          }

          async function api(path, options = {}) {
            const response = await fetch(API_BASE + path, {
              cache: 'no-store',
              ...options,
              headers: {
                Accept: 'application/json',
                ...(options.body ? {'Content-Type':'application/json'} : {}),
                ...(options.headers || {}),
                'X-Warranty-Admin-Key': ADMIN_ACCESS_KEY,
                'X-Shopify-Customer-Email': ADMIN.email || ''
              }
            });

            const payload = await response.json().catch(() => ({}));
            if (!response.ok) throw new Error(payload.error || 'Yêu cầu không thành công.');
            return payload;
          }

          const initialCreate = () => ({
            customerName: '',
            phone: '',
            email: '',
            sku: '',
            productName: '',
            purchaseDate: today(),
            purchaseLocation: 'Showroom L&M',
            warrantyNumber: ''
          });

          function Message({message}) {
            if (!message?.text) return null;
            return html`<div className=${'lmreact-message ' + (message.type || 'info')}>${message.text}</div>`;
          }

          function Button({children, variant='secondary', className='', ...props}) {
            return html`
              <button
                className=${`lmreact-btn ${variant} ${className}`}
                type="button"
                ...${props}
              >${children}</button>
            `;
          }

          function Field({label, help, full=false, children}) {
            return html`
              <label className=${'lmreact-field' + (full ? ' full' : '')}>
                <span className="lmreact-label">${label}</span>
                ${children}
                ${help ? html`<small>${help}</small>` : null}
              </label>
            `;
          }

          function Input(props) {
            return html`<input className="lmreact-input" ...${props} />`;
          }

          function Select({children, ...props}) {
            return html`<select className="lmreact-select" ...${props}>${children}</select>`;
          }

          function StatusPill({status}) {
            const active = status === 'activated';
            return html`
              <span className=${'lmreact-status ' + (active ? 'activated' : 'pending')}>
                ${active ? 'Đã kích hoạt' : 'Chưa kích hoạt'}
              </span>
            `;
          }

          function Stat({label, value, caption, tone='light'}) {
            return html`
              <article className=${'lmreact-stat ' + tone}>
                <span>${label}</span>
                <strong>${Number(value || 0).toLocaleString('vi-VN')}</strong>
                <small>${caption}</small>
              </article>
            `;
          }

          function Modal({open, title, kicker, onClose, children, footer}) {
            if (!open) return null;
            return html`
              <div className="lmreact-modal" role="dialog" aria-modal="true">
                <div className="lmreact-modal-backdrop" onClick=${onClose}></div>
                <section className="lmreact-modal-card">
                  <header className="lmreact-modal-head">
                    <div>
                      <span>${kicker}</span>
                      <h2>${title}</h2>
                    </div>
                    <${Button} onClick=${onClose}>ĐÓNG</${Button}>
                  </header>
                  <div className="lmreact-modal-body">${children}</div>
                  ${footer ? html`<footer className="lmreact-modal-foot">${footer}</footer>` : null}
                </section>
              </div>
            `;
          }

          function CreatePanel({onCreated}) {
            const [form, setForm] = useState(initialCreate);
            const [message, setMessage] = useState(null);
            const [result, setResult] = useState(null);
            const [saving, setSaving] = useState(false);
            const [generating, setGenerating] = useState(false);
            const [lookupLoading, setLookupLoading] = useState(false);

            const brand = useMemo(() => detectBrand(form.sku), [form.sku]);

            function patch(key, value) {
              setForm((prev) => ({...prev, [key]: value}));
            }

            async function lookupProduct() {
              const sku = normalizeSku(form.sku);
              if (!sku || form.productName.trim()) return;
              setLookupLoading(true);
              try {
                const data = await api('/admin/product?sku=' + encodeURIComponent(sku));
                if (data.productName) patch('productName', data.productName);
              } catch (e) {
                console.warn('Product lookup:', e);
              } finally {
                setLookupLoading(false);
              }
            }

            async function generateCode() {
              setGenerating(true);
              setMessage(null);
              try {
                const data = await api('/admin/generate-code');
                patch('warrantyNumber', data.warrantyNumber || '');
              } catch (e) {
                setMessage({type:'error', text:e.message});
              } finally {
                setGenerating(false);
              }
            }

            async function submit(e) {
              e.preventDefault();
              setMessage(null);
              setResult(null);

              if (!brand) {
                setMessage({type:'error', text:'SKU chưa nhận diện được thương hiệu.'});
                return;
              }

              if (!form.customerName.trim() || !form.phone.trim() || !form.email.trim() ||
                  !form.sku.trim() || !form.purchaseDate || !form.warrantyNumber.trim()) {
                setMessage({type:'error', text:'Vui lòng hoàn tất các trường bắt buộc.'});
                return;
              }

              setSaving(true);
              try {
                const data = await api('/admin/create', {
                  method:'POST',
                  body: JSON.stringify({
                    customerName: form.customerName.trim(),
                    phone: normalizePhone(form.phone),
                    email: normalizeEmail(form.email),
                    sku: normalizeSku(form.sku),
                    productName: form.productName.trim(),
                    purchaseDate: form.purchaseDate,
                    purchaseLocation: form.purchaseLocation,
                    warrantyNumber: normalizeCode(form.warrantyNumber)
                  })
                });

                setResult(data.warranty || null);
                setForm(initialCreate());
                await onCreated();
              } catch (e) {
                setMessage({type:'error', text:e.message});
              } finally {
                setSaving(false);
              }
            }

            return html`
              <section className="lmreact-panel">
                <header className="lmreact-panel-head">
                  <div>
                    <span className="lmreact-eyebrow">TẠO PHIẾU</span>
                    <h2>Thêm bảo hành mới</h2>
                    <p>Nhập thông tin khách hàng và sản phẩm để tạo hồ sơ bảo hành.</p>
                  </div>
                </header>

                <form className="lmreact-form" onSubmit=${submit}>
                  <section className="lmreact-form-section">
                    <div className="lmreact-section-title">
                      <span>01</span>
                      <div>
                        <strong>Thông tin khách hàng</strong>
                        <small>Dùng để đối chiếu khi khách kích hoạt bảo hành online.</small>
                      </div>
                    </div>

                    <div className="lmreact-grid two">
                      <${Field} label="Họ và tên *">
                        <${Input}
                          autoComplete="name"
                          value=${form.customerName}
                          onChange=${e => patch('customerName', e.target.value)}
                        />
                      </${Field}>

                      <${Field} label="Số điện thoại *">
                        <${Input}
                          type="tel"
                          inputMode="tel"
                          autoComplete="tel"
                          value=${form.phone}
                          onChange=${e => patch('phone', e.target.value)}
                        />
                      </${Field}>

                      <${Field}
                        label="Email *"
                        full=${true}
                        help="Email phải trùng với email khách dùng khi kích hoạt."
                      >
                        <${Input}
                          type="email"
                          autoComplete="email"
                          value=${form.email}
                          onChange=${e => patch('email', e.target.value)}
                        />
                      </${Field}>
                    </div>
                  </section>

                  <section className="lmreact-form-section">
                    <div className="lmreact-section-title">
                      <span>02</span>
                      <div>
                        <strong>Thông tin sản phẩm</strong>
                        <small>SKU được chuẩn hóa tự động và áp dụng thời hạn 24 tháng.</small>
                      </div>
                    </div>

                    <div className="lmreact-grid two">
                      <${Field}
                        label="SKU sản phẩm *"
                        help=${brand
                          ? `Đã nhận diện ${brand}.`
                          : form.sku
                            ? 'SKU chưa khớp thương hiệu đang cấu hình.'
                            : 'Nhập SKU để nhận diện thương hiệu.'}
                      >
                        <${Input}
                          value=${form.sku}
                          placeholder="Ví dụ: AOFH22514"
                          onChange=${e => patch('sku', normalizeSku(e.target.value))}
                          onBlur=${lookupProduct}
                          spellCheck=${false}
                        />
                      </${Field}>

                      <${Field} label="Thương hiệu">
                        <${Input}
                          value=${form.sku ? (brand || 'CHƯA NHẬN DIỆN') : ''}
                          readOnly=${true}
                          className=${'lmreact-input readonly ' + (brand ? 'recognized' : '')}
                        />
                      </${Field}>

                      <${Field} label="Tên sản phẩm" full=${true} help=${lookupLoading ? 'Đang tra cứu tên sản phẩm...' : ''}>
                        <${Input}
                          value=${form.productName}
                          onChange=${e => patch('productName', e.target.value)}
                        />
                      </${Field}>

                      <${Field} label="Ngày mua *">
                        <${Input}
                          type="date"
                          value=${form.purchaseDate}
                          onChange=${e => patch('purchaseDate', e.target.value)}
                        />
                      </${Field}>

                      <${Field} label="Thời hạn bảo hành">
                        <div className="lmreact-inline">
                          <${Input} value="24" readOnly=${true} className="lmreact-input readonly"/>
                          <span className="lmreact-addon">THÁNG</span>
                        </div>
                      </${Field}>

                      <${Field} label="Nơi mua">
                        <${Select}
                          value=${form.purchaseLocation}
                          onChange=${e => patch('purchaseLocation', e.target.value)}
                        >
                          ${LOCATION_OPTIONS.map(x => html`<option key=${x} value=${x}>${x}</option>`)}
                        </${Select}>
                      </${Field}>

                      <${Field} label="Số bảo hành *">
                        <div className="lmreact-inline code">
                          <${Input}
                            value=${form.warrantyNumber}
                            onChange=${e => patch('warrantyNumber', normalizeCode(e.target.value))}
                            spellCheck=${false}
                          />
                          <${Button}
                            className="code-btn"
                            variant="dark"
                            disabled=${generating}
                            onClick=${generateCode}
                          >${generating ? 'ĐANG TẠO' : 'TỰ SINH'}</${Button}>
                        </div>
                      </${Field}>
                    </div>
                  </section>

                  <${Message} message=${message}/>

                  <div className="lmreact-form-actions">
                    <${Button}
                      onClick=${() => {
                        setForm(initialCreate());
                        setMessage(null);
                        setResult(null);
                      }}
                    >LÀM MỚI</${Button}>
                    <${Button} type="submit" variant="dark" disabled=${saving}>
                      ${saving ? 'ĐANG LƯU' : 'TẠO PHIẾU BẢO HÀNH'}
                    </${Button}>
                  </div>
                </form>

                ${result ? html`
                  <section className="lmreact-created">
                    <span>PHIẾU ĐÃ TẠO</span>
                    <h3>${result.warranty_number}</h3>
                    <p>Hồ sơ đang chờ khách hàng kích hoạt.</p>
                    <div>
                      <article><small>Khách hàng</small><strong>${result.customer_name || '—'}</strong></article>
                      <article><small>SKU</small><strong>${result.sku || '—'}</strong><em>${result.brand || '—'}</em></article>
                      <article><small>Ngày mua</small><strong>${formatDate(result.purchase_date)}</strong></article>
                      <article><small>Thời hạn</small><strong>24 tháng</strong></article>
                    </div>
                  </section>
                ` : null}
              </section>
            `;
          }

          function ListPanel({warranties, loading, error, reload}) {
            const [search, setSearch] = useState('');
            const [filter, setFilter] = useState('all');
            const [page, setPage] = useState(1);
            const [migrationMessage, setMigrationMessage] = useState(null);
            const [migrating, setMigrating] = useState(false);
            const [editRecord, setEditRecord] = useState(null);
            const [deleteRecord, setDeleteRecord] = useState(null);
            const [modalMessage, setModalMessage] = useState(null);
            const [savingEdit, setSavingEdit] = useState(false);
            const [deleting, setDeleting] = useState(false);

            useEffect(() => setPage(1), [search, filter]);

            const rows = useMemo(() => {
              const q = search.trim().toLowerCase();
              return warranties.filter(item => {
                const statusOk =
                  filter === 'all' ||
                  (filter === 'activated' && item.status === 'activated') ||
                  (filter === 'pending' && item.status !== 'activated');
                if (!statusOk) return false;
                if (!q) return true;

                return [
                  item.warranty_number, item.customer_name, item.customer_phone,
                  item.customer_email, item.sku, item.brand, item.product_name
                ].join(' ').toLowerCase().includes(q);
              });
            }, [warranties, search, filter]);

            const pages = Math.max(1, Math.ceil(rows.length / PAGE_SIZE));
            const safePage = Math.min(page, pages);
            const start = (safePage - 1) * PAGE_SIZE;
            const visible = rows.slice(start, start + PAGE_SIZE);

            async function migrate() {
              if (!window.confirm('Đồng bộ dữ liệu bảo hành cũ sang danh sách hiện tại?')) return;
              setMigrating(true);
              setMigrationMessage(null);
              try {
                const data = await api('/admin/migrate', {
                  method:'POST',
                  body:JSON.stringify({})
                });
                setMigrationMessage({
                  type:'success',
                  text:`Đồng bộ hoàn tất: tạo ${data.created || 0} index mới, bỏ qua ${data.skipped || 0} index đã tồn tại.`
                });
                await reload();
              } catch (e) {
                setMigrationMessage({type:'error', text:e.message});
              } finally {
                setMigrating(false);
              }
            }

            async function saveEdit(form) {
              setSavingEdit(true);
              setModalMessage(null);
              try {
                await api('/admin/update', {
                  method:'POST',
                  body:JSON.stringify({
                    originalCode: normalizeCode(editRecord.warranty_number),
                    warrantyNumber: normalizeCode(form.warrantyNumber),
                    sku: normalizeSku(form.sku),
                    productName: form.productName.trim(),
                    customerName: form.customerName.trim(),
                    phone: normalizePhone(form.phone),
                    email: normalizeEmail(form.email),
                    purchaseDate: form.purchaseDate,
                    purchaseLocation: form.purchaseLocation
                  })
                });
                setEditRecord(null);
                await reload();
              } catch (e) {
                setModalMessage({type:'error', text:e.message});
              } finally {
                setSavingEdit(false);
              }
            }

            async function confirmDelete() {
              if (!deleteRecord) return;
              setDeleting(true);
              setModalMessage(null);
              try {
                await api('/admin/delete', {
                  method:'POST',
                  body:JSON.stringify({warrantyNumber:deleteRecord.warranty_number})
                });
                setDeleteRecord(null);
                await reload();
              } catch (e) {
                setModalMessage({type:'error', text:e.message});
              } finally {
                setDeleting(false);
              }
            }

            return html`
              <section className="lmreact-panel">
                <header className="lmreact-panel-head list-head">
                  <div>
                    <span className="lmreact-eyebrow">DANH SÁCH</span>
                    <h2>Hồ sơ bảo hành</h2>
                    <p>Tra cứu, chỉnh sửa và quản lý trạng thái của toàn bộ phiếu bảo hành.</p>
                  </div>
                  <div className="lmreact-head-actions">
                    <${Button} disabled=${migrating} onClick=${migrate}>
                      ${migrating ? 'ĐANG ĐỒNG BỘ' : 'ĐỒNG BỘ DỮ LIỆU CŨ'}
                    </${Button}>
                    <${Button} onClick=${reload}>LÀM MỚI</${Button}>
                  </div>
                </header>

                <${Message} message=${migrationMessage}/>

                <div className="lmreact-toolbar">
                  <label>
                    <span>Tìm kiếm</span>
                    <input
                      type="search"
                      value=${search}
                      onChange=${e => setSearch(e.target.value)}
                      placeholder="Mã bảo hành, SKU, khách hàng, SĐT hoặc email"
                    />
                  </label>
                  <label>
                    <span>Trạng thái</span>
                    <select value=${filter} onChange=${e => setFilter(e.target.value)}>
                      <option value="all">Tất cả</option>
                      <option value="pending">Chưa kích hoạt</option>
                      <option value="activated">Đã kích hoạt</option>
                    </select>
                  </label>
                </div>

                <div className="lmreact-list-meta">
                  ${loading ? 'Đang tải dữ liệu...' : `${rows.length.toLocaleString('vi-VN')} phiếu được hiển thị`}
                </div>

                ${error ? html`
                  <div className="lmreact-empty">
                    <strong>Không thể tải danh sách</strong>
                    <span>${error}</span>
                  </div>
                ` : loading ? html`
                  <div className="lmreact-skeleton-stack">
                    ${[1,2,3,4].map(x => html`<div key=${x} className="lmreact-skeleton"></div>`)}
                  </div>
                ` : visible.length ? html`
                  <div className="lmreact-records">
                    ${visible.map(item => html`
                      <article className="lmreact-record" key=${item.warranty_number}>
                        <div className="lmreact-record-main">
                          <span>SỐ BẢO HÀNH</span>
                          <strong>${item.warranty_number || '—'}</strong>
                          <small>${item.product_name || item.sku || 'Chưa có tên sản phẩm'}</small>
                        </div>
                        <div>
                          <span>KHÁCH HÀNG</span>
                          <strong>${item.customer_name || '—'}</strong>
                          <small>${item.customer_phone || item.customer_email || '—'}</small>
                        </div>
                        <div>
                          <span>SKU / THƯƠNG HIỆU</span>
                          <strong>${item.sku || '—'}</strong>
                          <small>${item.brand || detectBrand(item.sku) || '—'} · ${formatDate(item.purchase_date)}</small>
                        </div>
                        <div className="lmreact-record-status">
                          <span>TRẠNG THÁI</span>
                          <${StatusPill} status=${item.status}/>
                          <small>${formatDateTime(item.created_at)}</small>
                        </div>
                        <div className="lmreact-record-actions">
                          <${Button} onClick=${() => { setModalMessage(null); setEditRecord(item); }}>CHỈNH SỬA</${Button}>
                          <${Button} variant="danger" onClick=${() => { setModalMessage(null); setDeleteRecord(item); }}>XÓA</${Button}>
                        </div>
                      </article>
                    `)}
                  </div>
                ` : html`
                  <div className="lmreact-empty">
                    <strong>Không tìm thấy dữ liệu phù hợp</strong>
                    <span>Thử thay đổi từ khóa hoặc bộ lọc.</span>
                  </div>
                `}

                ${pages > 1 ? html`
                  <div className="lmreact-pagination">
                    <span>Trang ${safePage} / ${pages}</span>
                    <div>
                      <${Button} disabled=${safePage <= 1} onClick=${() => setPage(safePage - 1)}>TRƯỚC</${Button}>
                      <${Button} disabled=${safePage >= pages} onClick=${() => setPage(safePage + 1)}>SAU</${Button}>
                    </div>
                  </div>
                ` : null}

                <${EditModal}
                  record=${editRecord}
                  open=${Boolean(editRecord)}
                  onClose=${() => setEditRecord(null)}
                  onSave=${saveEdit}
                  saving=${savingEdit}
                  message=${modalMessage}
                />

                <${Modal}
                  open=${Boolean(deleteRecord)}
                  kicker="XÓA PHIẾU"
                  title="Xác nhận xóa hồ sơ"
                  onClose=${() => setDeleteRecord(null)}
                  footer=${html`
                    <${Button} onClick=${() => setDeleteRecord(null)}>HỦY</${Button}>
                    <${Button} variant="danger" disabled=${deleting} onClick=${confirmDelete}>
                      ${deleting ? 'ĐANG XÓA' : 'XÓA PHIẾU'}
                    </${Button}>
                  `}
                >
                  <div className="lmreact-delete-copy">
                    <p>Thao tác này sẽ xóa phiếu bảo hành khỏi hệ thống.</p>
                    <strong>${deleteRecord?.warranty_number || ''}</strong>
                    <${Message} message=${modalMessage}/>
                  </div>
                </${Modal}>
              </section>
            `;
          }

          function EditModal({record, open, onClose, onSave, saving, message}) {
            const [form, setForm] = useState(null);

            useEffect(() => {
              if (!record) return;
              setForm({
                warrantyNumber: record.warranty_number || '',
                sku: record.sku || '',
                productName: record.product_name || '',
                customerName: record.customer_name || '',
                phone: record.customer_phone || '',
                email: record.customer_email || '',
                purchaseDate: record.purchase_date || '',
                purchaseLocation: record.purchase_location || 'Khác'
              });
            }, [record]);

            if (!open || !form) return null;
            const brand = detectBrand(form.sku);
            const patch = (key, value) => setForm(prev => ({...prev,[key]:value}));

            return html`
              <${Modal}
                open=${open}
                kicker="CHỈNH SỬA"
                title="Cập nhật hồ sơ bảo hành"
                onClose=${onClose}
                footer=${html`
                  <${Button} onClick=${onClose}>HỦY</${Button}>
                  <${Button}
                    variant="dark"
                    disabled=${saving}
                    onClick=${() => {
                      if (!brand) return;
                      onSave(form);
                    }}
                  >${saving ? 'ĐANG LƯU' : 'LƯU THAY ĐỔI'}</${Button}>
                `}
              >
                <div className="lmreact-edit-status">
                  <span>TRẠNG THÁI HIỆN TẠI</span>
                  <${StatusPill} status=${record.status}/>
                </div>

                <div className="lmreact-grid two edit-grid">
                  <${Field} label="Số bảo hành *" full=${true}>
                    <${Input}
                      value=${form.warrantyNumber}
                      onChange=${e => patch('warrantyNumber', normalizeCode(e.target.value))}
                    />
                  </${Field}>

                  <${Field} label="SKU *" help=${brand ? `Đã nhận diện ${brand}.` : 'SKU chưa nhận diện được thương hiệu.'}>
                    <${Input}
                      value=${form.sku}
                      onChange=${e => patch('sku', normalizeSku(e.target.value))}
                    />
                  </${Field}>

                  <${Field} label="Thương hiệu">
                    <${Input}
                      value=${form.sku ? (brand || 'CHƯA NHẬN DIỆN') : ''}
                      readOnly=${true}
                      className=${'lmreact-input readonly ' + (brand ? 'recognized' : '')}
                    />
                  </${Field}>

                  <${Field} label="Tên sản phẩm" full=${true}>
                    <${Input}
                      value=${form.productName}
                      onChange=${e => patch('productName', e.target.value)}
                    />
                  </${Field}>

                  <${Field} label="Họ và tên *">
                    <${Input}
                      value=${form.customerName}
                      onChange=${e => patch('customerName', e.target.value)}
                    />
                  </${Field}>

                  <${Field} label="Số điện thoại *">
                    <${Input}
                      value=${form.phone}
                      onChange=${e => patch('phone', e.target.value)}
                    />
                  </${Field}>

                  <${Field} label="Email *" full=${true}>
                    <${Input}
                      type="email"
                      value=${form.email}
                      onChange=${e => patch('email', e.target.value)}
                    />
                  </${Field}>

                  <${Field} label="Ngày mua *">
                    <${Input}
                      type="date"
                      value=${form.purchaseDate}
                      onChange=${e => patch('purchaseDate', e.target.value)}
                    />
                  </${Field}>

                  <${Field} label="Nơi mua">
                    <${Select}
                      value=${form.purchaseLocation}
                      onChange=${e => patch('purchaseLocation', e.target.value)}
                    >
                      ${LOCATION_OPTIONS.map(x => html`<option key=${x} value=${x}>${x}</option>`)}
                    </${Select}>
                  </${Field}>
                </div>

                <${Message} message=${message}/>
              </${Modal}>
            `;
          }

          function App() {
            const [tab, setTab] = useState('create');
            const [warranties, setWarranties] = useState([]);
            const [loading, setLoading] = useState(true);
            const [error, setError] = useState('');

            async function load() {
              setLoading(true);
              setError('');
              try {
                const data = await api('/admin/list');
                setWarranties(Array.isArray(data.warranties) ? data.warranties : []);
              } catch (e) {
                setError(e.message);
              } finally {
                setLoading(false);
              }
            }

            useEffect(() => { load(); }, []);

            const activated = warranties.filter(x => x.status === 'activated').length;
            const pending = warranties.length - activated;

            return html`
              <div className="lmreact-app">
                <header className="lmreact-hero">
                  <div className="lmreact-hero-copy">
                    <span>WARRANTY MANAGEMENT</span>
                    <h1>Quản lý bảo hành</h1>
                    <p>Tạo mới, tra cứu và cập nhật hồ sơ bảo hành trong một giao diện vận hành tập trung.</p>
                  </div>
                  <div className="lmreact-account">
                    <div>
                      <span>ĐANG ĐĂNG NHẬP</span>
                      <strong>${ADMIN.email || '—'}</strong>
                    </div>
                    <shopify-account menu="customer-account-main-menu"></shopify-account>
                  </div>
                </header>

                <section className="lmreact-stats">
                  <${Stat} label="Tổng phiếu" value=${warranties.length} caption="Tổng hồ sơ" tone="dark"/>
                  <${Stat} label="Chưa kích hoạt" value=${pending} caption="Chờ kích hoạt"/>
                  <${Stat} label="Đã kích hoạt" value=${activated} caption="Đang có hiệu lực"/>
                </section>

                <div className="lmreact-workspace">
                  <aside className="lmreact-nav">
                    <button className=${tab === 'create' ? 'active' : ''} onClick=${() => setTab('create')}>
                      <span>01</span>
                      <strong>Tạo phiếu</strong>
                      <small>Thêm hồ sơ mới</small>
                    </button>
                    <button className=${tab === 'list' ? 'active' : ''} onClick=${() => setTab('list')}>
                      <span>02</span>
                      <strong>Danh sách</strong>
                      <small>Tra cứu & cập nhật</small>
                    </button>
                  </aside>

                  <main className="lmreact-content">
                    ${tab === 'create'
                      ? html`<${CreatePanel} onCreated=${load}/>`
                      : html`<${ListPanel}
                          warranties=${warranties}
                          loading=${loading}
                          error=${error}
                          reload=${load}
                        />`
                    }
                  </main>
                </div>
              </div>
            `;
          }

          ReactDOM.createRoot(document.getElementById('lmreact-root')).render(html`<${App}/>`);
        })();
        </script>

      {% else %}
        <div class="lmreact-auth-card">
          <span>QUYỀN TRUY CẬP</span>
          <h1>Chưa thể mở khu vực quản trị</h1>
          <p>Tài khoản này chưa được cấu hình đầy đủ quyền quản lý bảo hành.</p>
          <shopify-account menu="customer-account-main-menu"></shopify-account>
        </div>
      {% endif %}
    {% else %}
      <div class="lmreact-auth-card">
        <span>QUYỀN TRUY CẬP</span>
        <h1>Không có quyền truy cập</h1>
        <p>Tài khoản hiện tại chưa được cấp quyền quản lý bảo hành.</p>
        <shopify-account menu="customer-account-main-menu"></shopify-account>
      </div>
    {% endif %}
  {% else %}
    <div class="lmreact-auth-card">
      <span>QUẢN LÝ BẢO HÀNH</span>
      <h1>Xác thực tài khoản quản trị</h1>
      <p>Một mã xác thực sẽ được gửi đến email đăng ký.</p>

      <shopify-account id="lmreact-login-account" menu="customer-account-main-menu">
        <button type="button" slot="signed-out-avatar" class="lmreact-login-btn">
          XÁC THỰC TÀI KHOẢN
        </button>
      </shopify-account>
    </div>

    <script>
    (function(){
      function bind(){
        var account=document.getElementById('lmreact-login-account');
        if(!account || account.dataset.bound==='1') return;
        account.dataset.bound='1';
        account.addEventListener('close',function(){
          setTimeout(function(){ window.location.reload(); },850);
        });
      }
      if(customElements.get('shopify-account')) bind();
      else customElements.whenDefined('shopify-account').then(bind).catch(function(){});
    })();
    </script>
  {% endif %}
</section>

