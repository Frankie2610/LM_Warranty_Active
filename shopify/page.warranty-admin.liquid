  box-shadow:0 9px 22px rgba(31,42,34,.045);
}

.lmwa-stat span,
.lmwa-stat strong,
.lmwa-stat small{display:block}

.lmwa-stat span{
  color:#6c756e;
  font-size:9px;
  font-weight:800;
  letter-spacing:.08em;
  text-transform:uppercase;
}

.lmwa-stat strong{
  margin-top:8px;
  color:var(--ink);
  font-size:30px;
  font-weight:780;
  line-height:1;
  letter-spacing:-.035em;
}

.lmwa-stat small{
  margin-top:7px;
  color:#858d87;
  font-size:10px;
  font-weight:520;
}

.lmwa-stat.total{
  border-color:var(--forest);
  background:var(--forest);
}
.lmwa-stat.total span,
.lmwa-stat.total strong{color:#fff}
.lmwa-stat.total small{color:rgba(255,255,255,.62)}

/* ---------- Tabs ---------- */
.lmwa-tabs{
  display:flex;
  gap:6px;
  width:max-content;
  margin:24px 0 0;
  padding:5px;
  border:1px solid #d4dbd5;
  border-radius:12px;
  background:#e9edea;
}

.lmwa-tab{
  min-height:42px;
  padding:0 18px;
  border:0;
  border-radius:8px;
  background:transparent;
  color:#637067;
  cursor:pointer;
