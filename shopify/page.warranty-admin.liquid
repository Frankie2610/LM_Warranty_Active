{% comment %}
  L&M WARRANTY ADMIN — V8
  AUTH: Shopify Customer Account / OTP + Liquid tag gate.

  Required customer tags on each Admin Shopify customer:
  1) warranty-admin
  2) warranty-admin-key-YOUR_RANDOM_KEY

  The random key after "warranty-admin-key-" must exactly equal
  Vercel env WARRANTY_ADMIN_ACCESS_KEY.

  Firebase Authentication is NOT used.
  Firebase is only the Realtime Database behind Vercel Admin SDK.

  IMPORTANT:
  Replace API_BASE in the script after Vercel deployment.
{% endcomment %}

<script>
(function(){
  var src='https://cdn.shopify.com/storefront/web-components.js';

  if(
    !customElements.get('shopify-account') &&
    !document.querySelector('script[src="'+src+'"]')
  ){
    var s=document.createElement('script');
    s.src=src;
    s.async=true;
    document.head.appendChild(s);
  }
})();
</script>

{% assign warranty_admin_tag = 'warranty-admin' %}
{% assign warranty_admin_key = '' %}

{% if customer %}
  {% for tag in customer.tags %}
    {% if tag contains 'warranty-admin-key-' %}
      {% assign warranty_admin_key = tag | remove_first: 'warranty-admin-key-' | strip %}
    {% endif %}
  {% endfor %}
{% endif %}

